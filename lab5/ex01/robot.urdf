<?xml version="1.0" ?>
<robot name="differential_robot">

  <!-- ===== МАТЕРИАЛЫ ===== -->
  <material name="base_color">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="wheel_color">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="caster_color">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ===== ЗВЕНО: BASE_FOOTPRINT ===== -->
  <link name="base_footprint"/>

  <!-- ===== ЗВЕНО: BASE_LINK (основание робота) ===== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.8 0.5 0.2"/>
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <material name="base_color"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.8 0.5 0.2"/>
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <!-- Для box (0.8 x 0.5 x 0.2) m, масса 5 kg -->
      <inertia ixx="0.1708" ixy="0" ixz="0"
               iyy="0.2542" iyz="0"
               izz="0.3667"/>
    </inertial>
  </link>

  <!-- ===== СОЧЛЕНЕНИЕ: base_footprint → base_link ===== -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ===== ЗВЕНО: ЛЕВОЕ КОЛЕСО ===== -->
  <link name="wheel_left">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_color"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <!-- Для цилиндра (radius 0.1, length 0.08), масса 0.5 kg -->
      <inertia ixx="0.00208" ixy="0" ixz="0"
               iyy="0.00333" iyz="0"
               izz="0.00208"/>
    </inertial>
  </link>

  <!-- ===== СОЧЛЕНЕНИЕ: base_link → wheel_left ===== -->
  <joint name="wheel_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="-0.15 0.27 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-10" upper="10" effort="50" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ===== ЗВЕНО: ПРАВОЕ КОЛЕСО ===== -->
  <link name="wheel_right">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_color"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.00208" ixy="0" ixz="0"
               iyy="0.00333" iyz="0"
               izz="0.00208"/>
    </inertial>
  </link>

  <!-- ===== СОЧЛЕНЕНИЕ: base_link → wheel_right ===== -->
  <joint name="wheel_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="-0.15 -0.27 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-10" upper="10" effort="50" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ===== ЗВЕНО: ОПОРНОЕ КОЛЕСО (caster) ===== -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="caster_color"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Для сферы (radius 0.05), масса 0.2 kg -->
      <inertia ixx="0.00008" ixy="0" ixz="0"
               iyy="0.00008" iyz="0"
               izz="0.00008"/>
    </inertial>
  </link>

  <!-- ===== СОЧЛЕНЕНИЕ: base_link → caster_wheel ===== -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
  </joint>

</robot>
